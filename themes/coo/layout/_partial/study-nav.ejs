<aside class="study-sidebar" aria-label="Biblioteca de apuntes">
  <details class="study-navigation" open>
    <summary>Explorar apuntes <span aria-hidden="true">⌄</span></summary>
    <nav aria-label="Guías">
      <a class="study-overview" href="/" <%- is_home() ? 'aria-current="page"' : '' %>>Todos los apuntes</a>
      <% study_catalogue().forEach(function(group) { %>
        <div class="study-nav-group">
          <p><%= group.title %></p>
          <% group.items.forEach(function(item) { %>
            <a href="<%= url_for(item.path) %>" <%- page.path === item.path ? 'aria-current="page"' : '' %>><%= item.label %></a>
          <% }); %>
        </div>
      <% }); %>
    </nav>
  </details>
</aside>
