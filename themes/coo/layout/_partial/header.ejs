<header class="study-header">
  <div class="site-navbar-slot"><div class="site-navbar">
    <a class="study-brand" href="/" aria-label="Sheet Codes · Inicio"><span class="study-brand-mark" aria-hidden="true">&lt;/&gt;</span><span>Sheet Codes</span></a>
    <div class="study-header-actions">
      <button id="mysearch-trigger" class="study-search-trigger" type="button" aria-label="Buscar en los apuntes"><%- icon('search') %><span>Buscar en los apuntes</span><kbd>Ctrl K</kbd></button>
      <button id="darkMode" class="study-control" type="button" aria-label="Cambiar tema" title="Cambiar tema"><i class="icon-light"><%- icon('light') %></i><i class="icon-dark"><%- icon('dark') %></i></button>
      <div id="share-dropdown">
        <button id="share-trigger" class="study-control" type="button" aria-label="Compartir página" title="Compartir página" aria-expanded="false" aria-controls="share-menu"><%- icon('share') %></button>
      </div>
    </div>
  </div></div>
</header>
<div id="share-menu" class="fixed z-[9999] opacity-0 invisible scale-95 pointer-events-none" aria-label="Compartir página">
  <% [
    ['shareOnX', 'x', 'Compartir en X'],
    ['shareOnFacebook', 'facebook', 'Compartir en Facebook'],
    ['shareOnReddit', 'reddit', 'Compartir en Reddit'],
    ['shareOnPinterest', 'pinterest', 'Compartir en Pinterest'],
    ['shareOnLinkedIn', 'linkedin', 'Compartir en LinkedIn'],
    ['shareOnLine', 'line', 'Compartir en Line'],
    ['shareViaEmail', 'mail', 'Compartir por correo'],
    ['copyToClipboard', 'copy', 'Copiar enlace']
  ].forEach(function(item) { %>
    <button type="button" class="share-item" onclick="<%= item[0] %>()"><%- icon(item[1]) %><span><%= item[2] %></span></button>
  <% }); %>
</div>
