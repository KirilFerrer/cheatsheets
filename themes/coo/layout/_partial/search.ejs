<dialog id="mysearch" aria-labelledby="mysearch-title">
  <div id="mysearch-box">
    <div class="study-search-bar">
      <p id="mysearch-title" class="sr-only">Buscar apuntes</p>
      <label for="mysearch-input" class="study-search-label"><%- icon('search') %><span class="sr-only">Buscar en los apuntes</span></label>
      <input id="mysearch-input" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="128" placeholder="Buscar un tema o un concepto…" aria-describedby="mysearch-status">
      <button id="mysearch-clear" type="button" class="study-control" aria-label="Borrar búsqueda" hidden>×</button>
      <button type="button" class="cancel study-search-close">Cerrar <kbd>Esc</kbd></button>
    </div>
    <div class="study-search-feedback"><p id="mysearch-status" role="status"></p><button type="button" id="mysearch-retry" hidden>Volver a intentar</button></div>
    <div class="study-search-body">
      <div class="study-search-results"><ul id="mysearch-list" aria-label="Resultados de búsqueda"></ul></div>
      <aside class="preview-panel" aria-label="Apartados de la guía seleccionada"></aside>
    </div>
    <p class="study-search-hint">↑ ↓ para recorrer · Intro para abrir · Ctrl K para buscar</p>
  </div>
</dialog>
