<main class="study-catalogue-main" lang="es">
  <header class="study-page-heading">
    <nav class="learning-breadcrumb" aria-label="Ruta de navegación"><a href="/">Sheet Codes</a><span aria-hidden="true">/</span><span aria-current="page">Custom</span></nav>
    <h1>Custom</h1>
  </header>
  <div class="custom-guides">
    <% study_catalogue().find(function(group) { return group.id === 'custom'; }).items.forEach(function(item) { %>
      <article class="custom-guide">
        <a class="study-topic learning-custom" href="<%= url_for(item.path) %>"><div class="card"><%- icon(item.post.icon || 'code') %><p><%= item.label %></p></div></a>
        <p><%= item.post.intro %></p>
      </article>
    <% }); %>
  </div>
</main>
