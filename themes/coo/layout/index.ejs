<main class="study-catalogue-main" lang="es">
  <header class="study-page-heading">
    <h1>Apuntes de programación</h1>
  </header>
  <section class="catalogue" aria-label="Catálogo de apuntes">
    <div class="catalogue-content">
      <% study_catalogue().forEach(function(group) { %>
        <h2 class="catalogue-heading" id="<%= group.id %>"><%= group.category %></h2>
        <div class="catalogue-grid">
          <% if (group.id === 'custom') { group.items.forEach(function(item) { %>
            <a href="<%= url_for(item.path) %>" class="study-topic learning-custom" title="<%= item.label %>"><div class="card"><%- icon(item.post.icon || 'code') %><p><%= item.label %></p></div></a>
          <% }); } else { %>
            <a href="<%= url_for(group.items[0].path) %>" class="study-topic learning-<%= group.id %>" aria-controls="series-<%= group.id %>" aria-expanded="false" aria-haspopup="dialog" data-series-trigger="<%= group.id %>" title="Ver temas de <%= group.title %>"><div class="card"><%- icon(group.icon) %><p><%= group.title %></p></div></a>
            <div class="catalogue-description"><p><%= group.description %></p><span><%= group.items.map(function(item) { return item.label; }).join(' · ') %></span></div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </section>
</main>
<% study_catalogue().filter(function(group) { return group.id !== 'custom'; }).forEach(function(group) { %>
  <dialog class="series-dialog learning-<%= group.id %>" id="series-<%= group.id %>" aria-labelledby="series-<%= group.id %>-title" lang="es">
    <div class="series-dialog-body">
      <div class="series-dialog-heading"><h2 id="series-<%= group.id %>-title"><%= group.title %></h2><button type="button" class="study-control" data-close-series aria-label="Cerrar temas de <%= group.title %>">×</button></div>
      <nav class="series-options" aria-label="Temas de <%= group.title %>">
        <% group.items.forEach(function(item) { %><a class="study-topic" href="<%= url_for(item.path) %>"><div class="card"><%- icon(group.icon) %><p><%= item.label %></p></div></a><% }); %>
      </nav>
    </div>
  </dialog>
<% }); %>
